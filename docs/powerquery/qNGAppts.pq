// qNGAppts: the daily NextGen Appointments Listing. Names and DOBs stay: the Sohar import CSVs need them, and the add-in makes this sheet very hidden.
// Output: tblNGAppts  (load to a new sheet "NG Appointments", then Table Design > Table Name = tblNGAppts)
// Columns: (every column of the NextGen Appointments Listing)
// Generated by docs/powerquery/make-pq.mjs from rules.js (Sohar v0.30). Paste into Data > Get Data > Blank Query > Advanced Editor.
let
    // Text of a cell ('' for null); numbers without a trailing .0 (MRNs and Per Nbrs arrive as numbers sometimes).
    Txt = (v as any) as text => if v = null then "" else if Value.Is(v, type number) then (if Number.Round(v) = v then Number.ToText(v, "0") else Number.ToText(v, null, "en-US")) else Text.Trim(Text.From(v)),
    // M/D/YYYY, YYYY-MM-DD or a date -> "yyyy-MM-dd"; anything else as it was.
    IsoDay = (v as any) as text =>
        if v = null then ""
        else if Value.Is(v, type date) then Date.ToText(v, "yyyy-MM-dd")
        else if Value.Is(v, type datetime) then DateTime.ToText(v, "yyyy-MM-dd")
        else let s = Txt(v), p = Text.Split(Text.BeforeDelimiter(s, " "), "/") in
            if List.Count(p) = 3 and Text.Length(p{2}) = 4 then p{2} & "-" & Text.PadStart(p{0}, 2, "0") & "-" & Text.PadStart(p{1}, 2, "0")
            else if Text.Length(s) >= 10 and Text.Middle(s, 4, 1) = "-" then Text.Start(s, 10) else s,
    // Keep exactly Cols, in order: a column the source lacks comes in blank.
    Shape = (t as table, cols as list) as table =>
        let added = List.Accumulate(List.Difference(cols, Table.ColumnNames(t)), t, (acc, c) => Table.AddColumn(acc, c, each "", type text))
        in Table.SelectColumns(added, cols),
    // A CSV the rotation writes: UTF-8, quoted fields may span lines, a byte-order mark on the first header.
    ReadCsv = (bin as binary) as table =>
        let csv = Csv.Document(bin, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
            promoted = Table.PromoteHeaders(csv, [PromoteAllScalars = true])
        in Table.TransformColumnNames(promoted, each Text.Trim(Text.Replace(_, "#(feff)", ""))),
    Book = Excel.Workbook(Web.Contents(pPaths[NextGenAppointments]), null, true),
    Sheet = Table.SelectRows(Book, each [Kind] = "Sheet"){0}[Data],
    Rows = Table.ToRows(Sheet),
    Cells = (r as list) as list => List.Transform(r, Txt),
    // The header row moves (row 7 under the report's title rows): the first row holding Per Nbr and Appt Date / Appt Dt.
    HeaderAt = List.PositionOf(List.Transform(Rows, each let c = Cells(_) in List.Contains(c, "Per Nbr") and (List.Contains(c, "Appt Date") or List.Contains(c, "Appt Dt"))), true),
    Checked = if HeaderAt < 0 then error "The NextGen file has no header row with Per Nbr and Appt Date. Save the Appointments Listing again." else HeaderAt,
    Body = List.Skip(Rows, Checked + 1),
    // The report ends with "Total Appointments: n"; anything below it is not a visit.
    FooterAt = List.PositionOf(List.Transform(Body, each List.AnyTrue(List.Transform(Cells(_), (x) => Text.StartsWith(Text.Lower(x), "total appointments")))), true),
    Data = List.Select(if FooterAt < 0 then Body else List.FirstN(Body, FooterAt), each List.AnyTrue(List.Transform(Cells(_), (x) => x <> ""))),
    Raw = Cells(Rows{Checked}),
    Headers = List.Transform(List.Positions(Raw), (i) => if Raw{i} = "" then "Column" & Text.From(i + 1) else if List.Count(List.Select(List.FirstN(Raw, i), (x) => x = Raw{i})) > 0 then Raw{i} & " " & Text.From(i + 1) else Raw{i}),
    T = Table.FromRows(Data, Headers),
    // IDs and the start time as text (leading zeros, and "9:00 AM" the way the add-in reads it).
    TimeText = (v as any) as text => if Value.Is(v, type time) then Time.ToText(v, [Format = "h:mm tt", Culture = "en-US"]) else if Value.Is(v, type datetime) then DateTime.ToText(v, [Format = "h:mm tt", Culture = "en-US"]) else Txt(v),
    AsText = Table.TransformColumns(T, List.Transform(List.Intersect({Table.ColumnNames(T), {"MRN", "Md Rc", "Per Nbr"}}), (c) => {c, Txt, type text})),
    Times = Table.TransformColumns(AsText, List.Transform(List.Intersect({Table.ColumnNames(AsText), {"Beg Tm"}}), (c) => {c, TimeText, type text}))
in
    Times
