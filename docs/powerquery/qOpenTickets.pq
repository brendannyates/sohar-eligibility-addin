// qOpenTickets: the billing team's open tickets from BillingMaster. Open = Status not starting with Closed or Resolved, and not deleted. No submitter, notes or attachments.
// Output: tblOpenTickets  (load to a new sheet "Open Tickets", then Table Design > Table Name = tblOpenTickets)
// Columns: Ticket Id | Submitted | Clinic | LASFIR | MRN | Urgency | Task Type | Status | Amount | Confirmation Due | Resolution Due | Escalation Flag | Last Reply At
// Generated by docs/powerquery/make-pq.mjs from rules.js (Sohar v0.30). Paste into Data > Get Data > Blank Query > Advanced Editor.
let
    // Text of a cell ('' for null); numbers without a trailing .0 (MRNs and Per Nbrs arrive as numbers sometimes).
    Txt = (v as any) as text => if v = null then "" else if Value.Is(v, type number) then (if Number.Round(v) = v then Number.ToText(v, "0") else Number.ToText(v, null, "en-US")) else Text.Trim(Text.From(v)),
    // M/D/YYYY, YYYY-MM-DD or a date -> "yyyy-MM-dd"; anything else as it was.
    IsoDay = (v as any) as text =>
        if v = null then ""
        else if Value.Is(v, type date) then Date.ToText(v, "yyyy-MM-dd")
        else if Value.Is(v, type datetime) then DateTime.ToText(v, "yyyy-MM-dd")
        else let s = Txt(v), p = Text.Split(Text.BeforeDelimiter(s, " "), "/") in
            if List.Count(p) = 3 and Text.Length(p{2}) = 4 then p{2} & "-" & Text.PadStart(p{0}, 2, "0") & "-" & Text.PadStart(p{1}, 2, "0")
            else if Text.Length(s) >= 10 and Text.Middle(s, 4, 1) = "-" then Text.Start(s, 10) else s,
    // Keep exactly Cols, in order: a column the source lacks comes in blank.
    Shape = (t as table, cols as list) as table =>
        let added = List.Accumulate(List.Difference(cols, Table.ColumnNames(t)), t, (acc, c) => Table.AddColumn(acc, c, each "", type text))
        in Table.SelectColumns(added, cols),
    // A CSV the rotation writes: UTF-8, quoted fields may span lines, a byte-order mark on the first header.
    ReadCsv = (bin as binary) as table =>
        let csv = Csv.Document(bin, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
            promoted = Table.PromoteHeaders(csv, [PromoteAllScalars = true])
        in Table.TransformColumnNames(promoted, each Text.Trim(Text.Replace(_, "#(feff)", ""))),
    Book = Excel.Workbook(Web.Contents(pPaths[BillingForms]), null, true),
    Master = Table.SelectRows(Book, each [Item] = "BillingMaster" and [Kind] = "Table"){0}[Data],
    Live = Table.SelectRows(Master, each Txt([Deleted At]) = ""),
    Open = Table.SelectRows(Live, each let s = Text.Lower(Txt(Record.FieldOrDefault(_, "Status:", ""))) in not Text.StartsWith(s, "closed") and not Text.StartsWith(s, "resolved")),
    Out = Table.FromRecords(List.Transform(Table.ToRecords(Open), (r) => [
        #"Ticket Id" = Txt(r[Id]), Submitted = Record.FieldOrDefault(r, "Completion time", null), Clinic = Txt(Record.FieldOrDefault(r, "Patient Clinic:", "")),
        LASFIR = Txt(Record.FieldOrDefault(r, "Patient:", "")), MRN = Txt(Record.FieldOrDefault(r, "MRN:", "")),
        Urgency = Txt(Record.FieldOrDefault(r, "Urgency Level:", "")), #"Task Type" = Txt(Record.FieldOrDefault(r, "Task Type:", "")), Status = Txt(Record.FieldOrDefault(r, "Status:", "")),
        Amount = Txt(Record.FieldOrDefault(r, "Amount:", "")), #"Confirmation Due" = Record.FieldOrDefault(r, "Confirmation Due", null),
        #"Resolution Due" = Record.FieldOrDefault(r, "Resolution Due", null), #"Escalation Flag" = Txt(Record.FieldOrDefault(r, "Escalation Flag", "")),
        #"Last Reply At" = Txt(Record.FieldOrDefault(r, "Last Reply At", ""))])),
    Cols = {"Ticket Id", "Submitted", "Clinic", "LASFIR", "MRN", "Urgency", "Task Type", "Status", "Amount", "Confirmation Due", "Resolution Due", "Escalation Flag", "Last Reply At"},
    Shaped = Shape(if Table.RowCount(Out) = 0 then #table(Cols, {}) else Out, Cols)
in
    Shaped
