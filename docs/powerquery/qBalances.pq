// qBalances: patient balances from the NextGen balance report (not built yet: it needs an MRN or Per Nbr column and a patient balance column). Names are dropped.
// Output: tblPatientBalances  (load to a new sheet "Patient Balances", then Table Design > Table Name = tblPatientBalances)
// Columns: MRN | Per Nbr | Balance | As Of
// Generated by docs/powerquery/make-pq.mjs from rules.js (Sohar v0.30). Paste into Data > Get Data > Blank Query > Advanced Editor.
let
    // Text of a cell ('' for null); numbers without a trailing .0 (MRNs and Per Nbrs arrive as numbers sometimes).
    Txt = (v as any) as text => if v = null then "" else if Value.Is(v, type number) then (if Number.Round(v) = v then Number.ToText(v, "0") else Number.ToText(v, null, "en-US")) else Text.Trim(Text.From(v)),
    // M/D/YYYY, YYYY-MM-DD or a date -> "yyyy-MM-dd"; anything else as it was.
    IsoDay = (v as any) as text =>
        if v = null then ""
        else if Value.Is(v, type date) then Date.ToText(v, "yyyy-MM-dd")
        else if Value.Is(v, type datetime) then DateTime.ToText(v, "yyyy-MM-dd")
        else let s = Txt(v), p = Text.Split(Text.BeforeDelimiter(s, " "), "/") in
            if List.Count(p) = 3 and Text.Length(p{2}) = 4 then p{2} & "-" & Text.PadStart(p{0}, 2, "0") & "-" & Text.PadStart(p{1}, 2, "0")
            else if Text.Length(s) >= 10 and Text.Middle(s, 4, 1) = "-" then Text.Start(s, 10) else s,
    // Keep exactly Cols, in order: a column the source lacks comes in blank.
    Shape = (t as table, cols as list) as table =>
        let added = List.Accumulate(List.Difference(cols, Table.ColumnNames(t)), t, (acc, c) => Table.AddColumn(acc, c, each "", type text))
        in Table.SelectColumns(added, cols),
    // A CSV the rotation writes: UTF-8, quoted fields may span lines, a byte-order mark on the first header.
    ReadCsv = (bin as binary) as table =>
        let csv = Csv.Document(bin, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
            promoted = Table.PromoteHeaders(csv, [PromoteAllScalars = true])
        in Table.TransformColumnNames(promoted, each Text.Trim(Text.Replace(_, "#(feff)", ""))),
    Book = Excel.Workbook(Web.Contents(pPaths[NextGenBalances]), null, true),
    Sheet = Table.SelectRows(Book, each [Kind] = "Sheet"){0}[Data],
    Rows = Table.ToRows(Sheet),
    Cells = (r as list) as list => List.Transform(r, Txt),
    PatientCols = {"MRN", "Md Rc", "Per Nbr", "Person Nbr"},
    // The same order the eligibility-check --balances reader prefers: a patient balance before a plain balance.
    BalanceCols = {"Pat Bal", "Patient Balance", "Pat Resp", "Patient Due", "Balance", "Acct Bal", "Total Due"},
    HeaderAt = List.PositionOf(List.Transform(Rows, each let c = Cells(_) in List.ContainsAny(c, PatientCols) and List.ContainsAny(c, BalanceCols)), true),
    Checked = if HeaderAt < 0 then error "The balance file has no row with an MRN or Per Nbr column and a balance column." else HeaderAt,
    Raw = Cells(Rows{Checked}),
    T = Table.FromRows(List.Skip(Rows, Checked + 1), List.Transform(List.Positions(Raw), (i) => if Raw{i} = "" then "Column" & Text.From(i + 1) else Raw{i})),
    Mrn = List.First(List.Intersect({{"MRN", "Md Rc"}, Table.ColumnNames(T)}), null),
    Per = List.First(List.Intersect({{"Per Nbr", "Person Nbr"}, Table.ColumnNames(T)}), null),
    Bal = List.First(List.Select(BalanceCols, (c) => List.Contains(Table.ColumnNames(T), c))),
    Num = (v as any) as number => if v = null then 0 else if Value.Is(v, type number) then v else try Number.From(Text.Remove(Txt(v), {"$", ",", " "})) otherwise 0,
    Recs = List.Transform(Table.ToRecords(T), (r) => [MRN = if Mrn = null then "" else Txt(Record.Field(r, Mrn)), #"Per Nbr" = if Per = null then "" else Txt(Record.Field(r, Per)), Amt = Num(Record.Field(r, Bal))]),
    // Total and blank rows out; encounter rows summed per patient.
    Patients = List.Select(Recs, (r) => (r[MRN] <> "" or r[#"Per Nbr"] <> "") and not Text.StartsWith(Text.Lower(r[MRN] & r[#"Per Nbr"]), "total")),
    Grouped = if List.IsEmpty(Patients) then #table({"MRN", "Per Nbr", "Balance"}, {})
        else Table.Group(Table.FromRecords(Patients), {"MRN", "Per Nbr"}, {{"Balance", each List.Sum([Amt]), type number}}),
    // A file has no "last modified" here: As Of is the day of the refresh.
    Out = Table.AddColumn(Grouped, "As Of", each Date.ToText(Date.From(DateTime.LocalNow()), "yyyy-MM-dd"), type text)
in
    Out
